<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Tauri 打包时会把本文件合并进生成的 Info.plist。

  为什么要声明这些用途：macOS 的隐私权限（TCC）按「责任进程」判定。
  从 app_catch 直接运行的命令、脚本和开发态程序，责任进程是 app_catch 本身
  （与从终端启动时责任进程是 Terminal 同理）。责任进程的 Info.plist 里缺少某项用途说明时，
  子进程一请求该权限就会被系统直接杀掉，所以这里把常用的几项一次声明齐。
  详见 docs/MACOS_PERMISSIONS.md。
-->
<plist version="1.0">
<dict>
	<key>NSMicrophoneUsageDescription</key>
	<string>由 app_catch 启动的应用需要使用麦克风。</string>
	<key>NSCameraUsageDescription</key>
	<string>由 app_catch 启动的应用需要使用摄像头。</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>由 app_catch 启动的应用需要使用语音识别。</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>由 app_catch 启动的应用需要使用蓝牙。</string>
	<key>NSLocationUsageDescription</key>
	<string>由 app_catch 启动的应用需要获取位置。</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>由 app_catch 启动的应用需要获取位置。</string>
	<key>NSContactsUsageDescription</key>
	<string>由 app_catch 启动的应用需要访问通讯录。</string>
	<key>NSCalendarsUsageDescription</key>
	<string>由 app_catch 启动的应用需要访问日历。</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>由 app_catch 启动的应用需要访问日历。</string>
	<key>NSRemindersUsageDescription</key>
	<string>由 app_catch 启动的应用需要访问提醒事项。</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>由 app_catch 启动的应用需要访问提醒事项。</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>由 app_catch 启动的应用需要访问照片图库。</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>由 app_catch 启动的应用需要控制其他应用。</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>由 app_catch 启动的应用需要访问本地网络。</string>
</dict>
</plist>
